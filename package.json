{
  "name": "@fountain-bio/acuity",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fountain-Bio/acuity.git"
  },
  "bin": {
    "acuity": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware && oxfmt --check",
    "fmt": "oxfmt",
    "release": "npm version",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "release:beta": "npm version prerelease --preid=beta"
  },
  "dependencies": {
    "yargs": "^18.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/yargs": "^17.0.35",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7"
  },
  "peerDependencies": {}
}
